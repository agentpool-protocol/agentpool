{
  "name": "agentpool-protocol",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://agentpool-protocol.asfu.chatgpt.site",
  "repository": {
    "type": "git",
    "url": "https://github.com/agentpool-protocol/agentpool.git"
  },
  "bugs": {
    "url": "https://github.com/agentpool-protocol/agentpool/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --test tests/*.test.mjs",
    "test:site": "npm run build && node --test tests/rendered-html.test.mjs",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "testnet:wallets": "node scripts/setup-base-sepolia-wallets.mjs",
    "contracts:preflight": "node --env-file-if-exists=.env.local scripts/preflight-deploy.mjs",
    "contracts:deploy": "node --env-file-if-exists=.env.local scripts/deploy.mjs",
    "contracts:verify": "node --env-file-if-exists=.env.local scripts/verify-deployment.mjs",
    "contracts:deploy:v3": "node --env-file-if-exists=.env.local scripts/deploy-base-sepolia-v3.mjs",
    "contracts:verify:v3": "node --env-file-if-exists=.env.local scripts/verify-base-sepolia-v3.mjs",
    "testnet:commerce": "node --env-file-if-exists=.env.local scripts/smoke-base-sepolia-commerce.mjs",
    "testnet:mining": "node --env-file-if-exists=.env.local scripts/smoke-base-sepolia-mining.mjs",
    "testnet:mining:wait": "node --env-file-if-exists=.env.local scripts/smoke-base-sepolia-mining.mjs --wait",
    "testnet:safe": "node --env-file-if-exists=.env.local scripts/smoke-base-sepolia-safe.mjs",
    "testnet:owner-safe": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.wallets.local scripts/setup-base-sepolia-owner-safe.mjs",
    "wallets:plan-mainnet": "node --env-file-if-exists=.env.wallets.local scripts/plan-mainnet-safes.mjs",
    "contracts:rehearse": "node scripts/rehearse-deployment.mjs",
    "pilot:v3": "node scripts/run-codex-pilot-v3.mjs",
    "simulate:v4.1": "node scripts/simulate-v41-economy.mjs",
    "contracts:rehearse:v4.1": "node scripts/rehearse-v41-deployment.mjs",
    "contracts:preflight:v4.1": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.v41.local scripts/preflight-v41-base-sepolia.mjs",
    "contracts:deploy:v4.1": "node --env-file-if-exists=.env.local scripts/deploy-v41-base-sepolia.mjs",
    "contracts:verify:v4.1": "node --env-file-if-exists=.env.local scripts/verify-v41-base-sepolia.mjs",
    "mcp:bundle": "node scripts/bundle-mcp.mjs",
    "mcp:self-test": "node mcp/agentpool-local.mjs --self-test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@hpke/chacha20poly1305": "^1.8.0",
    "@hpke/core": "^1.9.0",
    "@hpke/dhkem-x25519": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openzeppelin/contracts": "^5.6.1",
    "drizzle-orm": "0.45.2",
    "next": "^16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "viem": "^2.55.8",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@ethereumjs/block": "^10.1.2",
    "@ethereumjs/common": "^10.1.2",
    "@ethereumjs/tx": "^10.1.2",
    "@ethereumjs/util": "^10.1.2",
    "@ethereumjs/vm": "^10.1.2",
    "@safe-global/protocol-kit": "^8.0.4",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "solc": "^0.8.36",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "fast-uri": "3.1.4",
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "type": "module"
}
