# Base Sepolia only. Never commit real secrets.
AGENTPOOL_WALLET_PROFILE=
AGENTPOOL_CHAIN_ID=84532
AGENTPOOL_RPC_URL=https://sepolia.base.org
DEPLOYER_PRIVATE_KEY=
# Optional override; defaults to 0.001 test ETH in wei.
MIN_DEPLOYER_BALANCE_WEI=

# Long-lived roles. Use distinct public addresses. On mainnet, all eight role
# addresses, including FOUNDER_BENEFICIARY, must be distinct 2-of-3 Safes that
# share the planned desktop, laptop, and phone owner set. See
# PRODUCTION_WALLETS.md.
GOVERNANCE_MULTISIG=
ECOSYSTEM_TREASURY=
OPERATIONS_TREASURY=
VALIDATOR_TREASURY=
AUTHOR_TREASURY=
LIQUIDITY_TREASURY=
FOUNDER_BENEFICIARY=
SECURITY_TREASURY=

# Deterministic marketplace verifier and the shared five-validator bootstrap set.
INITIAL_VERIFIER_ADAPTER=
INITIAL_VERIFIER_IMPLEMENTATION_HASH=
VALIDATOR_1=
VALIDATOR_2=
VALIDATOR_3=
VALIDATOR_4=
VALIDATOR_5=

# Unix timestamps. The first benchmark cap defaults to 1,000,000 whole APOOL/day.
BENCHMARK_GENESIS_TIMESTAMP=
BENCHMARK_DAILY_CAP_APOOL=1000000
FOUNDER_VESTING_START_TIMESTAMP=
PUBLIC_SITE_URL=https://agentpool-protocol.asfu.chatgpt.site

# AgentPool v4.1 Base Sepolia. Use a fresh testnet-only deployer. Catalog
# signers must be five distinct, numerically sorted public addresses and must
# not include the deployer. Keep each signer key on an independent device or
# process; the gateway never stores these private keys.
V41_DEPLOYER_PRIVATE_KEY=
MIN_V41_DEPLOYER_BALANCE_WEI=30000000000000
V41_CATALOG_SIGNER_1=
V41_CATALOG_SIGNER_2=
V41_CATALOG_SIGNER_3=
V41_CATALOG_SIGNER_4=
V41_CATALOG_SIGNER_5=
# Testnet-only signing material for catalog admission smoke tests. Keep private.
V41_CATALOG_SIGNER_PRIVATE_KEY_1=
V41_CATALOG_SIGNER_PRIVATE_KEY_2=
V41_CATALOG_SIGNER_PRIVATE_KEY_3=
V41_CATALOG_SIGNER_PRIVATE_KEY_4=
V41_CATALOG_SIGNER_PRIVATE_KEY_5=
V41_GENESIS_TIMESTAMP=

# AgentPool v4.3 Base Sepolia BOOTSTRAP. Reuses DEPLOYER_PRIVATE_KEY above.
# Genesis defaults to one hour in the future when omitted.
V43_GENESIS_TIMESTAMP=
V431_GENESIS_TIMESTAMP=
V433_GENESIS_TIMESTAMP=
V434_GENESIS_TIMESTAMP=
V435_GENESIS_TIMESTAMP=
MIN_V43_DEPLOYER_BALANCE_WEI=100000000000000

# Hosted secret used to derive private capability exercises. Store only as a
# Sites secret environment variable; never commit the real value.
V41_CHALLENGE_SECRET=
# Optional Base Sepolia address that receives rewards from the disposable local
# MCP pilot before its temporary worker key is deleted. Defaults to the v4.1
# test deployer address.
V41_PILOT_PAYOUT_ADDRESS=

# Mainnet-only values. The script also requires every matching gate in
# mainnet-gates.json to be approved with the exact same evidence digest.
CHAINLINK_VRF_ADAPTER=
MAINNET_AUDIT_REPORT_SHA256=
MAINNET_LEGAL_MEMO_SHA256=
MAINNET_TRADEMARK_EVIDENCE_SHA256=
MAINNET_TESTNET_REPORT_SHA256=
MAINNET_VALIDATOR_ECONOMICS_SHA256=
MAINNET_MULTISIG_EVIDENCE_SHA256=
